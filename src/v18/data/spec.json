{
  "buildHeader": {
    "tagName": "th",
    "textContent": "${columnName}",
    "attributes": {
      "class": "py-3 px-3 fw-semibold text-uppercase small"
    }
  },
  "tableSearchBar": {
    "tagName": "div",
    "attributes": {
      "class": "row mb-3 align-items-center"
    },
    "children": [
      {
        "tagName": "div",
        "attributes": {
          "class": "col-md-4 d-flex align-items-center"
        },
        "children": [
          {
            "tagName": "h6",
            "attributes": {
              "class": "mb-0 fw-semibold text-secondary",
              "id": "table-title"
            },
            "textContent": "Items"
          }
        ]
      },
      {
        "tagName": "div",
        "attributes": {
          "class": "col-md-4 text-center d-flex align-items-center justify-content-center"
        },
        "children": [
          {
            "tagName": "span",
            "attributes": {
              "id": "search-feedback",
              "class": "badge bg-white text-secondary border px-3 py-2 small fw-normal shadow-sm"
            },
            "textContent": "Showing all records"
          }
        ]
      },
      {
        "tagName": "div",
        "attributes": {
          "class": "col-md-4"
        },
        "children": [
          {
            "tagName": "div",
            "attributes": {
              "class": "input-group"
            },
            "children": [
              {
                "tagName": "span",
                "attributes": {
                  "class": "input-group-text bg-white"
                },
                "children": [
                  {
                    "tagName": "i",
                    "attributes": {
                      "class": "bi bi-search"
                    },
                    "textContent": "🔍"
                  }
                ]
              },
              {
                "tagName": "input",
                "attributes": {
                  "type": "text",
                  "id": "tableSearch",
                  "class": "form-control",
                  "placeholder": "Search table..."
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "buildBodyTr": {
    "tagName": "tr",
    "attributes": {
      "class": "align-middle"
    },
    "children": []
  },
  "buildColGroup": {
    "tagName": "col",
    "attributes": {
      "width": "${width}"
    }
  },
  "tableHeaderClickable": {
    "tagName": "th",
    "attributes": {
      "class": "py-3 px-3 fw-semibold text-uppercase small user-select-none",
      "role": "button",
      "tabindex": "0",
      "style": "cursor: pointer;",
      "data-column": "${columnName}",
      "data-sort-order": "none",
      "data-role": "sortable-header"
    },
    "children": [
      {
        "tagName": "span",
        "attributes": {
          "class": "d-inline-flex align-items-center gap-2"
        },
        "children": [
          {
            "tagName": "span",
            "textContent": "${columnName}"
          },
          {
            "tagName": "span",
            "textContent": "⇅",
            "attributes": {
              "class": "small opacity-75",
              "data-role": "sort-indicator"
            }
          }
        ]
      }
    ]
  },
  "buildFooter": {
    "tagName": "td",
    "children": [
      {
        "tagName": "input",
        "attributes": {
          "type": "text",
          "placeholder": "enter ${columnName}",
          "name": "${columnName}",
          "id": "${columnName}",
          "list": "${columnName}",
          "class": "form-control"
        }
      }
    ]
  },
  "buildBodyCell": {
    "tagName": "td",
    "textContent": "${rowValue}",
    "attributes": {
      "class": "py-3 px-3 text-secondary"
    }
  },
  "button": {
    "tagName": "button",
    "textContent": "${columnName}",
    "attributes": {
      "class": "btn btn-primary btn-sm"
    }
  },
  "buttonCell": {
    "tagName": "td",
    "attributes": {
      "class": "py-2 px-3 text-center"
    },
    "children": [
      {
        "tagName": "button",
        "textContent": "${agg:count}",
        "attributes": {
          "class": "btn btn-primary btn-sm"
        }
      }
    ]
  },
  "optionsButtonCell": {
    "tagName": "td",
    "attributes": {
      "class": "py-2 px-3 text-center"
    },
    "children": [
      {
        "tagName": "button",
        "textContent": "show",
        "attributes": {
          "class": "btn btn-primary btn-sm ks-btn-show"
        }
      }
    ]
  },
  "buildOption": {
    "tagName": "option",
    "textContent": "${rowValue}",
    "attributes": {
      "value": "${rowValue}"
    }
  },
  "buildSelect": {
    "tagName": "select",
    "attributes": {
      "id": "${columnName}",
      "name": "${columnName}",
      "data-name": "${columnName}",
      "class": "form-select shadow-sm mb-3"
    },
    "children": []
  },
  "buildDataList": {
    "tagName": "datalist",
    "attributes": {
      "id": "${columnName}",
      "data-name": "${columnName}"
    },
    "children": []
  },
  "buildFormField": {
    "tagName": "div",
    "attributes": {
      "class": "mb-3"
    },
    "children": [
      {
        "tagName": "label",
        "textContent": "${columnName}",
        "attributes": {
          "for": "${columnName}",
          "class": "form-label fw-semibold text-capitalize"
        }
      },
      {
        "tagName": "input",
        "attributes": {
          "type": "text",
          "id": "${columnName}",
          "name": "${columnName}",
          "placeholder": "Enter ${columnName}...",
          "class": "form-control"
        }
      }
    ]
  },
  "emptyCell": {
    "tagName": "td",
    "children": []
  },
  "headerSerialCell": {
    "tagName": "th",
    "textContent": "#",
    "attributes": {
      "class": "py-3 px-3 fw-semibold text-uppercase small"
    }
  },
  "colGroupForSerial": {
    "tagName": "col",
    "attributes": {
      "width": "50px"
    }
  },
  "colGroupForOption": {
    "tagName": "col",
    "attributes": {
      "width": "100px"
    }
  },
  "headerForOption": {
    "tagName": "th",
    "textContent": "options",
    "attributes": {
      "class": "py-3 px-3 fw-semibold text-uppercase small"
    }
  },
  "tdWithButtonSaveWarning": {
    "tagName": "td",
    "attributes": {
      "class": "py-2 px-3 text-center"
    },
    "children": [
      {
        "tagName": "button",
        "textContent": "save",
        "attributes": {
          "class": "btn btn-warning btn-sm ks-btn-save"
        }
      }
    ]
  },
  "tableSearch": {
    "tagName": "div",
    "attributes": {
      "class": "row mb-3 justify-content-end"
